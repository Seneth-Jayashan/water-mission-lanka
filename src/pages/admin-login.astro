---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Admin Login | Water Mission Lanka">
  <main class="login-page">
    <section class="login-panel" aria-label="Admin login">

      <div class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M12 3.25c3.2 3.44 5.25 6.24 5.25 9.04a5.25 5.25 0 0 1-10.5 0c0-2.8 2.05-5.6 5.25-9.04Z"/>
          <path d="M9.35 13.1c.52 1.35 1.42 2.03 2.65 2.03"/>
        </svg>
      </div>

      <div class="login-heading">
        <p class="eyebrow">Water Mission Lanka</p>
        <h1>Welcome back</h1>
        <p class="subtitle">Sign in to manage the admin dashboard.</p>
      </div>

      <div id="create-admin-section" class="callout callout--amber" hidden>
        <div class="callout__body">
          <svg class="callout__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
          </svg>
          <p>No admin account exists. Create one using your environment credentials below.</p>
        </div>
        <button id="create-admin-btn" type="button" class="btn btn--green">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
            <circle cx="8.5" cy="7" r="4"/>
            <line x1="20" y1="8" x2="20" y2="14"/>
            <line x1="23" y1="11" x2="17" y2="11"/>
          </svg>
          Create admin account
        </button>
      </div>

      <form id="login-form" class="login-form" novalidate>
        <div class="field">
          <label for="username">Username</label>
          <input
            id="username"
            name="username"
            type="text"
            autocomplete="username"
            placeholder="Enter your username"
            required
          />
        </div>

        <div class="field">
          <label for="password">Password</label>
          <div class="input-wrap">
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              placeholder="Enter your password"
              required
            />
            <button type="button" id="toggle-pw" class="toggle-pw" aria-label="Show password">
              <svg id="eye-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <svg id="eye-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="hidden">
                <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/>
                <line x1="1" y1="1" x2="23" y2="23"/>
              </svg>
            </button>
          </div>
        </div>

        <button id="submit" type="submit" class="btn btn--primary">
          <span id="btn-label">Sign in</span>
          <svg id="btn-spinner" class="spinner hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
          </svg>
        </button>

        <div id="message" role="status" aria-live="polite" class="login-message"></div>
      </form>

      <a href="/" class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Back to website
      </a>

    </section>
  </main>
</Layout>

<style>
  /* ── Hard reset to prevent overlaps ── */
  .login-page, .login-page * {
    box-sizing: border-box;
  }

  [hidden] {
    display: none !important;
  }

  .hidden { 
    display: none !important; 
  }

  /* ── Page ── */
  .login-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 24px;
    background:
      radial-gradient(ellipse at 10% 10%, rgba(0, 129, 201, 0.1) 0%, transparent 50%),
      radial-gradient(ellipse at 90% 90%, rgba(0, 129, 201, 0.07) 0%, transparent 50%),
      #f0f6fb;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
    color: #0f172a;
    overflow-y: auto; /* Allow scrolling on extremely tiny screens */
  }

  /* ── Panel ── */
  .login-panel {
    width: 100%;
    max-width: 420px;
    padding: 40px 36px;
    background: #fff;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(15, 73, 103, 0.12), 0 4px 16px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
  }

  /* ── Brand mark ── */
  .brand-mark {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    margin: 0 auto 24px;
    border-radius: 12px;
    color: #0081c9;
    background: linear-gradient(145deg, #e0f1fb, #c8e7f8);
    border: 1px solid rgba(0, 129, 201, 0.2);
    flex-shrink: 0;
  }
  .brand-mark svg {
    width: 28px;
    height: 28px;
  }

  /* ── Heading ── */
  .login-heading {
    text-align: center;
    margin-bottom: 32px;
  }
  .eyebrow {
    margin: 0 0 6px;
    color: #0081c9;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .login-heading h1 {
    margin: 0;
    color: #0f172a;
    font-size: 30px;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .subtitle {
    margin: 8px 0 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.6;
  }

  /* ── Callout ── */
  .callout {
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 28px;
    border: 1px solid;
  }
  .callout--amber {
    background: #fffbeb;
    border-color: #fde68a;
  }
  .callout__body {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 12px;
  }
  .callout__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-top: 1px;
    color: #d97706;
  }
  .callout__body p {
    margin: 0;
    color: #92400e;
    font-size: 13px;
    line-height: 1.55;
  }

  /* ── Form ── */
  .login-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    width: 100%;
  }
  .field label {
    font-size: 13px;
    font-weight: 700;
    color: #334155;
    letter-spacing: 0.01em;
  }
  .field input {
    width: 100%;
    height: 46px;
    padding: 0 14px;
    border: 1.5px solid #e2e8f0;
    border-radius: 9px;
    color: #0f172a;
    background: #fff;
    font: inherit;
    font-size: 15px;
    outline: none;
    transition: border-color 150ms ease, box-shadow 150ms ease;
    flex-shrink: 0;
  }
  .field input::placeholder { color: #94a3b8; }
  .field input:hover  { border-color: #94a3b8; }
  .field input:focus  { border-color: #0081c9; box-shadow: 0 0 0 3px rgba(0, 129, 201, 0.15); }

  /* Password wrapper */
  .input-wrap {
    position: relative;
    width: 100%;
    display: block;
  }
  .input-wrap input {
    padding-right: 46px;
  }
  .toggle-pw {
    position: absolute;
    right: 0;
    top: 0;
    height: 46px;
    width: 44px;
    display: grid;
    place-items: center;
    background: none;
    border: none;
    cursor: pointer;
    color: #94a3b8;
    padding: 0;
    transition: color 150ms ease;
  }
  .toggle-pw:hover { color: #475569; }
  .toggle-pw svg   { width: 18px; height: 18px; }

  /* ── Buttons ── */
  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 48px;
    border: none;
    border-radius: 10px;
    font: inherit;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: background 160ms ease, transform 120ms ease, box-shadow 160ms ease, opacity 160ms ease;
    flex-shrink: 0;
  }
  .btn svg { width: 17px; height: 17px; }

  .btn--primary {
    color: #fff;
    background: #0081c9;
    box-shadow: 0 4px 14px rgba(0, 129, 201, 0.3);
    margin-top: 4px;
  }
  .btn--primary:hover   { background: #006ba6; transform: translateY(-1px); box-shadow: 0 6px 18px rgba(0, 129, 201, 0.35); }
  .btn--primary:active  { transform: translateY(0); }
  .btn--primary:disabled { opacity: 0.65; cursor: not-allowed; transform: none; }

  .btn--green {
    color: #fff;
    background: #10b981;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.25);
  }
  .btn--green:hover  { background: #059669; transform: translateY(-1px); box-shadow: 0 6px 18px rgba(16, 185, 129, 0.32); }
  .btn--green:active { transform: translateY(0); }

  /* ── Spinner ── */
  @keyframes spin { to { transform: rotate(360deg); } }
  .spinner { animation: spin 0.75s linear infinite; width: 18px; height: 18px; }

  /* ── Status message ── */
  .login-message {
    min-height: 20px;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    color: #dc2626;
    line-height: 1.5;
    transition: color 200ms ease;
  }
  .login-message.success { color: #059669; }

  /* ── Back link ── */
  .back-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    margin-top: 24px;
    color: #64748b;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: color 150ms ease;
  }
  .back-link:hover { color: #0081c9; }
  .back-link svg   { width: 15px; height: 15px; }

  /* ── Mobile ── */
  @media (max-width: 480px) {
    .login-panel { padding: 28px 22px; }
    .login-heading h1 { font-size: 26px; }
  }
</style>

<script type="module">
  const BACKEND_URL = 'http://localhost:8000/public/api/login.php';

  const form           = document.getElementById('login-form');
  const msgEl          = document.getElementById('message');
  const submitBtn      = document.getElementById('submit');
  const btnLabel       = document.getElementById('btn-label');
  const btnSpinner     = document.getElementById('btn-spinner');
  const createSection  = document.getElementById('create-admin-section');
  const createAdminBtn = document.getElementById('create-admin-btn');
  const togglePwBtn    = document.getElementById('toggle-pw');
  const pwInput        = document.getElementById('password');
  const eyeShow        = document.getElementById('eye-show');
  const eyeHide        = document.getElementById('eye-hide');

  /* ── Helpers ── */
  function setMsg(text, type = 'error') {
    msgEl.textContent = text;
    msgEl.className = 'login-message' + (type === 'success' ? ' success' : '');
  }

  function setLoading(on) {
    submitBtn.disabled = on;
    btnLabel.textContent = on ? 'Signing in…' : 'Sign in';
    btnSpinner.classList.toggle('hidden', !on);
  }

  /* ── Password toggle ── */
  togglePwBtn.addEventListener('click', () => {
    const isHidden = pwInput.type === 'password';
    pwInput.type = isHidden ? 'text' : 'password';
    eyeShow.classList.toggle('hidden', isHidden);
    eyeHide.classList.toggle('hidden', !isHidden);
    togglePwBtn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
  });

  /* ── Check admin exists on load ── */
  (async () => {
    try {
      const res  = await fetch(BACKEND_URL);
      const data = await res.json();
      if (data.success && !data.adminExists) {
        createSection.removeAttribute('hidden');
      }
    } catch (err) {
      console.error('Failed to check admin status:', err);
    }
  })();

  /* ── Create admin ── */
  createAdminBtn.addEventListener('click', async () => {
    createAdminBtn.disabled = true;
    createAdminBtn.style.opacity = '0.65';
    setMsg('Creating admin account…', 'neutral');
    try {
      const res  = await fetch(BACKEND_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'create_admin' })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        setMsg(data.message || 'Admin account created. You can now sign in.', 'success');
        createSection.setAttribute('hidden', '');
      } else {
        setMsg(data.error || 'Failed to create admin account.');
        createAdminBtn.disabled = false;
        createAdminBtn.style.opacity = '';
      }
    } catch {
      setMsg('Network error. Please try again.');
      createAdminBtn.disabled = false;
      createAdminBtn.style.opacity = '';
    }
  });

  /* ── Login ── */
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    setMsg('');
    setLoading(true);

    const username = document.getElementById('username').value.trim();
    const password = pwInput.value;

    if (!username || !password) {
      setMsg('Please enter your username and password.');
      setLoading(false);
      return;
    }

    try {
      const res = await fetch(BACKEND_URL, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password })
      });

      const contentType = res.headers.get('content-type') || '';
      if (!contentType.includes('application/json')) {
        const text = await res.text();
        console.error('Non-JSON response:', text);
        setMsg('Unexpected server response. Check console for details.');
        setLoading(false);
        return;
      }

      const payload = await res.json();
      if (res.ok && payload?.success) {
        setMsg('Login successful — redirecting…', 'success');
        btnLabel.textContent = 'Redirecting…';
        setTimeout(() => { window.location.href = '/admin'; }, 600);
      } else {
        setMsg(payload?.error || 'Incorrect username or password.');
        setLoading(false);
      }
    } catch {
      setMsg('Network error. Please check your connection.');
      setLoading(false);
    }
  });
</script>