---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Admin Login | Water Mission Lanka">
  <main class="admin-login-page">
    <section class="login-panel" aria-label="Admin login">
      <div class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M12 3.25c3.2 3.44 5.25 6.24 5.25 9.04a5.25 5.25 0 0 1-10.5 0c0-2.8 2.05-5.6 5.25-9.04Z"/>
          <path d="M9.35 13.1c.52 1.35 1.42 2.03 2.65 2.03"/>
        </svg>
      </div>

      <div class="login-heading">
        <p>Water Mission Lanka</p>
        <h1>Welcome Back</h1>
        <span>Please sign in to manage the admin dashboard.</span>
      </div>

      <div id="create-admin-section" style="display: none;" class="create-admin-alert" style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 12px; padding: 18px; margin-bottom: 24px;">
        <div class="alert-content" style="display: flex; align-items: flex-start; gap: 12px; margin-bottom: 16px; text-align: left;">
          <svg width="24" height="24" style="color: #f59e0b; flex-shrink: 0; margin-top: 2px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <p style="color: #475569; font-size: 13px; margin: 0; line-height: 1.5;">
            No admin account exists. Click below to create one using environment credentials.
          </p>
        </div>
        <button id="create-admin-btn" type="button" class="create-admin-btn" style="display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
          </svg>
          Create Admin Account
        </button>
      </div>
      

      <form id="login-form" class="login-form">
        <div class="field">
          <label for="username">Username</label>
          <input id="username" name="username" autocomplete="username" value="admin" />
        </div>

        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" value="admin123" />
        </div>

        <button id="submit" type="submit" class="login-button">Sign In</button>
        <div id="message" role="status" class="login-message"></div>
      </form>

      <a href="/" class="site-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Back to Website
      </a>
    </section>
  </main>
</Layout>

<style>
  .admin-login-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    color: #0f172a;
    background:
      radial-gradient(circle at 15% 15%, rgba(0, 129, 201, 0.14), transparent 30%),
      linear-gradient(135deg, #eef7fb 0%, #f8fafc 46%, #e7f3f8 100%);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .login-panel {
    width: min(100%, 430px);
    padding: 34px;
    border: 1px solid rgba(148, 163, 184, 0.28);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 24px 60px rgba(15, 73, 103, 0.16);
  }

  .brand-mark {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    margin: 0 auto 20px;
    border-radius: 8px;
    color: #0081c9;
    background: #e6f4fb;
  }

  .brand-mark svg {
    width: 30px;
    height: 30px;
  }

  .login-heading {
    text-align: center;
    margin-bottom: 28px;
  }

  .login-heading p {
    margin: 0 0 8px;
    color: #0081c9;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .login-heading h1 {
    margin: 0;
    color: #0f172a;
    font-size: clamp(28px, 6vw, 36px);
    line-height: 1.1;
    font-weight: 800;
  }

  .login-heading span {
    display: block;
    margin-top: 10px;
    color: #64748b;
    font-size: 14px;
    line-height: 1.6;
  }

  /* UPDATED CSS FOR ADMIN BUTTON SECTION ONLY */
  .create-admin-alert {
    background: #f8fafc;
    border: 1px dashed #cbd5e1;
    border-radius: 12px;
    padding: 18px;
    margin-bottom: 24px;
  }

  .alert-content {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
  }

  .alert-icon {
    width: 20px;
    height: 20px;
    color: #f59e0b;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .create-admin-alert p {
    color: #475569;
    font-size: 13px;
    margin: 0;
    line-height: 1.5;
  }

  .create-admin-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #10b981;
    color: white;
    border: none;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 200ms ease;
    width: 100%;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
  }

  .create-admin-btn:hover {
    background: #059669;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(16, 185, 129, 0.3);
  }

  .create-admin-btn svg {
    width: 16px;
    height: 16px;
  }
  /* END UPDATED CSS */

  .login-form {
    display: grid;
    gap: 18px;
  }

  .field label {
    display: block;
    margin-bottom: 8px;
    color: #334155;
    font-size: 13px;
    font-weight: 700;
  }

  .field input {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    color: #0f172a;
    background: #ffffff;
    font: inherit;
    font-size: 15px;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .field input:focus {
    border-color: #0081c9;
    box-shadow: 0 0 0 4px rgba(0, 129, 201, 0.14);
  }

  .login-button {
    width: 100%;
    min-height: 48px;
    margin-top: 4px;
    border: 0;
    border-radius: 8px;
    color: #ffffff;
    background: #0081c9;
    box-shadow: 0 12px 22px rgba(0, 129, 201, 0.22);
    font: inherit;
    font-size: 15px;
    font-weight: 800;
    cursor: pointer;
    transition: background 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  }

  .login-button:hover {
    background: #006ba6;
    transform: translateY(-1px);
    box-shadow: 0 16px 26px rgba(0, 129, 201, 0.26);
  }

  .login-message {
    min-height: 20px;
    color: #dc2626;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
  }

  .site-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    margin-top: 22px;
    color: #64748b;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .site-link:hover {
    color: #0081c9;
  }

  .site-link svg {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
  }

  @media (max-width: 480px) {
    .admin-login-page {
      padding: 16px;
    }

    .login-panel {
      padding: 26px 20px;
    }
  }
</style>

<script type="module">
const form = document.getElementById('login-form');
const msg = document.getElementById('message');
const BACKEND_URL = 'http://localhost:8000/public/api/login.php';

// Check if admin exists on page load
document.addEventListener('DOMContentLoaded', async () => {
  try {
    const res = await fetch(BACKEND_URL);
    const data = await res.json();
    if (data.success && !data.adminExists) {
      document.getElementById('create-admin-section').style.display = 'block';
    }
  } catch (err) {
    console.error('Failed to check admin status:', err);
  }
});

const createAdminBtn = document.getElementById('create-admin-btn');
if (createAdminBtn) {
  createAdminBtn.addEventListener('click', async () => {
    msg.style.color = '#334155';
    msg.textContent = 'Creating admin...';
    try {
      const res = await fetch(BACKEND_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'create_admin' })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        msg.style.color = '#10b981'; // Green success color
        msg.textContent = data.message;
        document.getElementById('create-admin-section').style.display = 'none';
      } else {
        msg.style.color = '#dc2626';
        msg.textContent = data.error || 'Failed to create admin';
      }
    } catch (err) {
      msg.style.color = '#dc2626';
      msg.textContent = 'Network error during creation';
      console.error(err);
    }
  });
}

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  msg.style.color = '#dc2626';
  msg.textContent = '';
  const username = document.getElementById('username').value;
  const password = document.getElementById('password').value;

  try {
    const res = await fetch(BACKEND_URL, {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, password })
    });

    // Try to parse JSON; fallback to text for debugging if server returned HTML
    const contentType = res.headers.get('content-type') || '';
    let payload = null;
    if (contentType.includes('application/json')) {
      payload = await res.json();
    } else {
      const text = await res.text();
      // Likely PHP source or HTML error — show helpful message
      msg.textContent = 'Server returned non-JSON response. See console.';
      console.error('Non-JSON response:', text);
      return;
    }

    if (res.ok && payload && payload.success) {
      msg.style.color = '#10b981';
      msg.textContent = 'Login successful — opening admin panel...';
      // redirect to frontend admin dashboard (stays on Astro, not the PHP backend)
      window.location.href = '/admin';
    } else {
      msg.textContent = payload?.error || 'Login failed';
    }
  } catch (err) {
    msg.textContent = 'Network error';
    console.error(err);
  }
});
</script>