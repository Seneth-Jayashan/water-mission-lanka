---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="min-h-screen bg-[#f0f4f8] flex items-center justify-center p-4">
    <div class="bg-white p-8 rounded-2xl shadow-xl w-full max-w-md border border-gray-100">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-slate-900 mb-2">Welcome Back</h1>
        <p class="text-slate-500 text-sm">Please sign in to the admin dashboard</p>
      </div>
      <form id="login-form" class="space-y-5">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Username</label>
          <input id="username" name="username" class="w-full border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#0081c9] focus:border-transparent transition-all" value="admin" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-2">Password</label>
          <input id="password" name="password" type="password" class="w-full border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#0081c9] focus:border-transparent transition-all" value="admin123" />
        </div>
        <div class="pt-2">
          <button id="submit" type="submit" class="w-full bg-[#0081c9] hover:bg-[#006ba6] text-white font-bold py-3 px-4 rounded-xl transition-colors shadow-md shadow-blue-100 flex justify-center items-center">
            Sign In
          </button>
        </div>
        <div id="message" role="status" class="text-sm text-center text-red-500 font-medium h-4"></div>
      </form>
      <div class="mt-8 text-center">
        <a href="/" class="text-sm text-slate-500 hover:text-[#0081c9] transition-colors flex items-center justify-center gap-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Back to Website
        </a>
      </div>
    </div>
  </main>
</Layout>

<script type="module">
const form = document.getElementById('login-form');
const msg = document.getElementById('message');

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  msg.textContent = '';
  const username = document.getElementById('username').value;
  const password = document.getElementById('password').value;

  try {
    // Use full backend URL so the request reaches the PHP server (not Astro dev server)
    const BACKEND_URL = 'http://localhost:8000/public/api/login.php';
    const res = await fetch(BACKEND_URL, {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, password })
    });

    // Try to parse JSON; fallback to text for debugging if server returned HTML
    const contentType = res.headers.get('content-type') || '';
    let payload = null;
    if (contentType.includes('application/json')) {
      payload = await res.json();
    } else {
      const text = await res.text();
      // Likely PHP source or HTML error — show helpful message
      msg.textContent = 'Server returned non-JSON response. See console.';
      console.error('Non-JSON response:', text);
      return;
    }

    if (res.ok && payload && payload.success) {
      msg.textContent = 'Login successful — opening admin panel...';
      // redirect to frontend admin dashboard (stays on Astro, not the PHP backend)
      window.location.href = '/admin';
    } else {
      msg.textContent = payload?.error || 'Login failed';
    }
  } catch (err) {
    msg.textContent = 'Network error';
    console.error(err);
  }
});
</script>
