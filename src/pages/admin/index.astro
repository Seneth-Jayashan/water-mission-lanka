---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout pageTitle="Dashboard">
  <div class="page-stack">
    <div class="page-toolbar">
      <div class="page-heading">
        <h2>Dashboard</h2>
        <p class="text-muted">Quick overview of products, categories, and admin system status.</p>
      </div>
    </div>

    <div class="stat-grid">
      <div class="stat-card shadow-sm">
        <div class="stat-icon stat-icon-blue">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        </div>
        <div class="stat-content">
          <div class="stat-label">Total Products</div>
          <div class="stat-value" id="stat-products">
            <span class="spinner-small loading-spinner"></span>
          </div>
        </div>
      </div>
      
      <div class="stat-card shadow-sm">
        <div class="stat-icon stat-icon-indigo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </div>
        <div class="stat-content">
          <div class="stat-label">Categories</div>
          <div class="stat-value" id="stat-categories">
            <span class="spinner-small loading-spinner"></span>
          </div>
        </div>
      </div>
      
      <div class="stat-card shadow-sm">
        <div class="stat-icon stat-icon-green">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </div>
        <div class="stat-content">
          <div class="stat-label">System Status</div>
          <div class="stat-value flex items-center gap-2">
            <span class="status-indicator"></span>
            <span class="text-success text-lg">Online</span>
          </div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-header flex justify-between items-center">
        <h3>Recent Products</h3>
        <a href="/admin/products/" class="btn btn-ghost btn-sm flex items-center gap-1">
          View All
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="table-wrap">
        <table class="table-modern">
          <thead>
            <tr>
              <th style="width: 80px;">Image</th>
              <th>Name</th>
              <th>Price (LKR)</th>
              <th>Categories</th>
            </tr>
          </thead>
          <tbody id="dashboard-recent-products">
            <tr>
              <td colspan="4">
                <div class="empty-state">
                  <span class="spinner loading-spinner"></span>
                  <p>Loading recent products...</p>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <style>
    /* --- Scoped UI Enhancements --- */
    
    /* Stats Cards */
    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem; }
    .stat-card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; display: flex; align-items: center; gap: 1rem; transition: transform 0.2s, box-shadow 0.2s; }
    .stat-card:hover { transform: translateY(-2px); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05); }
    .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .stat-icon svg { width: 24px; height: 24px; }
    .stat-icon-blue { background: #eff6ff; color: #3b82f6; }
    .stat-icon-indigo { background: #eef2ff; color: #6366f1; }
    .stat-icon-green { background: #ecfdf5; color: #10b981; }
    
    .stat-content { display: flex; flex-direction: column; gap: 0.25rem; }
    .stat-label { font-size: 0.875rem; color: #64748b; font-weight: 500; }
    .stat-value { font-size: 1.5rem; font-weight: 700; color: #0f172a; line-height: 1; min-height: 24px; }
    
    .status-indicator { width: 10px; height: 10px; background-color: #10b981; border-radius: 50%; display: inline-block; box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2); animation: pulse 2s infinite; }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); } 70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); } 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); } }

    /* Card Layouts */
    .card-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid #e2e8f0; }
    .card-header h3 { margin: 0; font-size: 1.1rem; color: #0f172a; font-weight: 600; }
    
    /* Table & Thumbnails */
    .table-modern th { background: #f8fafc; font-weight: 600; color: #475569; padding: 12px 16px; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; }
    .table-modern td { padding: 12px 16px; vertical-align: middle; border-bottom: 1px solid #e2e8f0; }
    .thumb { width: 44px; height: 44px; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; background-color: #f8fafc; }
    .thumb-empty { background: #f1f5f9; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #94a3b8; font-weight: 600; }
    
    /* Utilities */
    .text-success { color: #10b981; }
    .text-muted { color: #64748b; }
    .text-lg { font-size: 1.125rem; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #64748b; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
    .empty-icon { color: #cbd5e1; margin-bottom: 0.5rem; }
    .spinner-small { width: 16px; height: 16px; border-width: 2px; }
  </style>

  <script type="module">
    // Formats numbers to LKR currency standard (e.g., 1,500.00)
    const formatCurrency = (amount) => {
      return new Intl.NumberFormat('en-LK', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(amount);
    };

    async function loadDashboard() {
      try {
        const [prodRes, catRes] = await Promise.all([
          fetch(`${window.API}/products.php?limit=5&sort=newest`, { credentials: 'include' }),
          fetch(`${window.API}/categories.php`, { credentials: 'include' })
        ]);
        
        const prodData = await prodRes.json();
        const catData = await catRes.json();

        // Update Stat Counters
        document.getElementById('stat-products').textContent = prodData.meta?.total ?? 0;
        document.getElementById('stat-categories').textContent = (catData.categories || []).length;

        // Render Recent Products
        const recent = (prodData.products || []).slice(0, 5);
        const tbody = document.getElementById('dashboard-recent-products');
        
        if (!recent.length) {
          tbody.innerHTML = `
            <tr>
              <td colspan="4">
                <div class="empty-state">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-icon"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                  <strong>No products yet</strong>
                  <p class="text-sm">Add a product to start populating your dashboard.</p>
                </div>
              </td>
            </tr>`;
          return;
        }

        tbody.innerHTML = recent.map(p => {
          const thumb = p.thumbnail
            ? `<img src="${window.esc(p.thumbnail)}" alt="${window.esc(p.name)}" class="thumb shadow-sm" />`
            : '<div class="thumb thumb-empty">N/A</div>';
            
          const cats = (p.categories || []).map(c => `<span class="badge badge-purple">${window.esc(c.name)}</span>`).join(' ');
          
          return `<tr>
            <td>${thumb}</td>
            <td><strong class="row-title">${window.esc(p.name)}</strong></td>
            <td class="font-mono text-sm">${formatCurrency(Number(p.price))}</td>
            <td><div class="category-list flex gap-1 flex-wrap">${cats || '<span class="text-muted text-sm">--</span>'}</div></td>
          </tr>`;
        }).join('');
        
      } catch {
        // Handle Error States
        document.getElementById('stat-products').textContent = '--';
        document.getElementById('stat-categories').textContent = '--';
        document.getElementById('dashboard-recent-products').innerHTML = `
          <tr>
            <td colspan="4">
              <div class="empty-state text-danger">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-icon text-danger"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                <p>Failed to load dashboard data. Please check your connection.</p>
              </div>
            </td>
          </tr>`;
      }
    }

    if(typeof window.setActiveNav === 'function') window.setActiveNav('dashboard');
    loadDashboard();
  </script>
</AdminLayout>