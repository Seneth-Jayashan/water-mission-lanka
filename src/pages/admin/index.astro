---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout pageTitle="Dashboard">
  <div class="page-stack">
    <div class="page-toolbar">
      <div class="page-heading">
        <h2>Dashboard</h2>
        <p>Quick overview of products, categories, and admin system status.</p>
      </div>
    </div>

    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(0,129,201,0.12);color:#0081c9;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        </div>
        <div class="stat-label">Total Products</div>
        <div class="stat-value" id="stat-products">--</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(0,118,182,0.1);color:#0076b6;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </div>
        <div class="stat-label">Categories</div>
        <div class="stat-value" id="stat-categories">--</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon" style="background:rgba(16,185,129,0.12);color:#10b981;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </div>
        <div class="stat-label">Status</div>
        <div class="stat-value" style="font-size:18px;color:var(--success);">Online</div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3>Recent Products</h3>
        <a href="/admin/products/" class="btn btn-primary btn-sm">View All</a>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Image</th><th>Name</th><th>Price (LKR)</th><th>Categories</th></tr></thead>
          <tbody id="dashboard-recent-products"><tr><td colspan="4"><div class="empty-state">Loading products...</div></td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  <script type="module">
    async function loadDashboard() {
      try {
        const [prodRes, catRes] = await Promise.all([
          fetch(`${window.API}/products.php?limit=5&sort=newest`, { credentials: 'include' }),
          fetch(`${window.API}/categories.php`, { credentials: 'include' })
        ]);
        const prodData = await prodRes.json();
        const catData = await catRes.json();

        document.getElementById('stat-products').textContent = prodData.meta?.total ?? 0;
        document.getElementById('stat-categories').textContent = (catData.categories || []).length;

        const recent = (prodData.products || []).slice(0, 5);
        const tbody = document.getElementById('dashboard-recent-products');
        if (!recent.length) {
          tbody.innerHTML = '<tr><td colspan="4"><div class="empty-state"><strong>No products yet</strong>Add a product to start filling the dashboard.</div></td></tr>';
          return;
        }

        tbody.innerHTML = recent.map(p => {
          const thumb = p.thumbnail
            ? `<img src="${window.esc(p.thumbnail)}" alt="" class="thumb" />`
            : '<div class="thumb thumb-empty">N/A</div>';
          const cats = (p.categories || []).map(c => `<span class="badge badge-purple">${window.esc(c.name)}</span>`).join('');
          return `<tr>
            <td>${thumb}</td>
            <td><span class="row-title">${window.esc(p.name)}</span></td>
            <td>${Number(p.price).toFixed(2)}</td>
            <td><div class="category-list">${cats || '<span class="row-muted">--</span>'}</div></td>
          </tr>`;
        }).join('');
      } catch {
        document.getElementById('dashboard-recent-products').innerHTML = '<tr><td colspan="4"><div class="empty-state" style="color:var(--danger);">Failed to load products</div></td></tr>';
      }
    }

    window.setActiveNav('dashboard');
    loadDashboard();
  </script>
</AdminLayout>
