---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout pageTitle="Products">
  <div class="page-stack">
    <div class="page-toolbar">
      <div class="page-heading">
        <h2>Products</h2>
        <p>Create, search, edit, and organize product listings.</p>
      </div>
      <div class="toolbar-actions">
        <div class="search-input-wrapper">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input type="text" placeholder="Search products..." id="product-search" class="search-input" />
        </div>
        <button class="btn btn-primary" id="add-product-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
          Add Product
        </button>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="table-wrap">
        <table class="table-modern">
          <thead>
            <tr>
              <th style="width: 80px;">Image</th>
              <th>Name</th>
              <th>Price (LKR)</th>
              <th>Categories</th>
              <th>Gallery</th>
              <th style="width:180px;">Actions</th>
            </tr>
          </thead>
          <tbody id="products-table-body">
            <tr>
              <td colspan="6">
                <div class="empty-state">
                  <span class="spinner loading-spinner"></span>
                  <p>Loading products...</p>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Add/Edit Product Modal -->
  <div class="modal-overlay" id="product-modal">
    <div class="modal modal-lg">
      <div class="modal-header">
        <h3 id="product-modal-title">Add Product</h3>
        <button class="btn-icon" onclick="closeModal('product-modal')" aria-label="Close product modal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <form id="product-form" enctype="multipart/form-data">
          <input type="hidden" id="pf-id" name="id" />
          
          <div class="form-group">
            <label for="pf-name">Product Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="pf-name" name="name" placeholder="e.g., Wireless Bluetooth Headphones" required />
          </div>
          
          <div class="form-group">
            <label for="pf-desc">Description</label>
            <textarea class="form-control" id="pf-desc" name="description" rows="3" placeholder="Describe the product features and details..."></textarea>
          </div>
          
          <div class="form-row grid-cols-2">
            <div class="form-group">
              <label for="pf-price">Price <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text">LKR</span>
                <input type="number" step="0.01" min="0" class="form-control" id="pf-price" name="price" placeholder="0.00" required />
              </div>
            </div>
            <div class="form-group">
              <label for="pf-categories">Category <span class="text-danger">*</span></label>
              <select class="form-control" id="pf-categories" name="category_ids[]" required>
                <option value="">-- Select a category --</option>
              </select>
            </div>
          </div>

          <div class="form-divider"></div>

          <div class="form-group">
            <label>Product Images <span class="text-muted">(Max 6)</span></label>
            <p class="form-hint text-sm text-muted mb-3">Click a slot to upload. Max 2MB per image. Accepted formats: JPG, PNG, WEBP.</p>
            
            <div class="image-slots" id="pf-image-slots">
              <!-- Six slots -->
              <template id="pf-image-slot-template">
                <div class="slot">
                  <input type="file" accept="image/jpeg,image/png,image/webp" class="slot-input" />
                  <div class="slot-preview">
                    <img src="" alt="" style="display:none;" />
                    <div class="slot-placeholder">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                    </div>
                    <button type="button" class="slot-remove" style="display:none;" title="Remove image">&times;</button>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" onclick="closeModal('product-modal')">Cancel</button>
        <button class="btn btn-primary" id="product-save-btn">
          <span id="product-save-text">Save Product</span>
          <span class="spinner" id="product-save-spinner" style="display:none;"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div class="modal-overlay" id="delete-modal">
    <div class="modal modal-sm">
      <div class="modal-header">
        <h3 class="text-danger flex items-center gap-2">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Confirm Deletion
        </h3>
        <button class="btn-icon" onclick="closeModal('delete-modal')" aria-label="Close delete modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <p id="delete-message" class="text-muted">Are you sure you want to delete this item? This action cannot be undone.</p>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" onclick="closeModal('delete-modal')">Cancel</button>
        <button class="btn btn-danger" id="delete-confirm-btn">Delete Product</button>
      </div>
    </div>
  </div>

  <style>
    /* --- Scoped UI Enhancements --- */
    
    /* Table & Thumbnails */
    .table-modern th { background: #f8fafc; font-weight: 600; color: #475569; padding: 12px 16px; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; }
    .table-modern td { padding: 12px 16px; vertical-align: middle; border-bottom: 1px solid #e2e8f0; }
    .thumb { width: 44px; height: 44px; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; }
    .thumb-empty { background: #f1f5f9; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #94a3b8; font-weight: 600; }
    
    /* Search & Inputs */
    .search-input-wrapper { position: relative; display: flex; align-items: center; }
    .search-icon { position: absolute; left: 12px; color: #94a3b8; width: 16px; height: 16px; pointer-events: none; }
    .search-input { width: 280px; padding: 8px 12px 8px 36px; border-radius: 6px; border: 1px solid #cbd5e1; height: 38px; font-size: 0.9rem; transition: all 0.3s ease; background: #fff; }
    .search-input:hover { border-color: #94a3b8; box-shadow: 0 2px 4px rgba(148, 163, 184, 0.1); }
    .search-input:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1), 0 2px 8px rgba(59, 130, 246, 0.15); background: #f8fafc; }
    .search-input::placeholder { color: #cbd5e1; }
    .input-group { display: flex; align-items: center; }
    .input-group-text { background: #f1f5f9; border: 1px solid #cbd5e1; border-right: none; padding: 0 12px; height: 42px; display: flex; align-items: center; border-radius: 6px 0 0 6px; color: #475569; font-weight: 500; font-size: 0.9rem; }
    .input-group input { border-radius: 0 6px 6px 0; height: 42px; }
    .form-control { width: 100%; border: 1px solid #cbd5e1; border-radius: 6px; padding: 8px 12px; transition: border-color 0.2s; }
    .form-control:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
    .form-row.grid-cols-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .form-divider { height: 1px; background: #e2e8f0; margin: 1.5rem 0; }
    
    /* Image Uploader Grid */
    .image-slots { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 12px; margin-top: 8px; }
    .slot { border: 2px dashed #cbd5e1; border-radius: 8px; height: 100px; display: flex; align-items: center; justify-content: center; position: relative; cursor: pointer; transition: all 0.2s ease; overflow: hidden; background: #f8fafc; }
    .slot:hover { border-color: #3b82f6; background: #eff6ff; color: #3b82f6; }
    .slot-input { display: none; }
    .slot-preview { width: 100%; height: 100%; position: relative; display: flex; align-items: center; justify-content: center; }
    .slot-preview img { width: 100%; height: 100%; object-fit: cover; }
    .slot-placeholder { color: inherit; display: flex; align-items: center; justify-content: center; }
    .slot-remove { position: absolute; top: 4px; right: 4px; background: rgba(15, 23, 42, 0.7); color: white; border: none; border-radius: 50%; width: 22px; height: 22px; font-size: 14px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.2s; backdrop-filter: blur(2px); }
    .slot-remove:hover { background: #ef4444; }
    
    /* Utilities */
    .text-danger { color: #ef4444; }
    .text-muted { color: #64748b; }
    .modal-lg { max-width: 650px; width: 100%; }
    .modal-sm { max-width: 400px; width: 100%; }
    .empty-state { text-align: center; padding: 3rem 1rem; color: #64748b; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
    .empty-icon { color: #cbd5e1; margin-bottom: 0.5rem; }
  </style>

  <script type="module">
    let allProducts = [];
    let allCategories = [];
    let pendingDeleteFn = null;

    window._pf_remove_filenames = [];

    // Formats numbers to LKR currency standard (e.g., 1,500.00)
    const formatCurrency = (amount) => {
      return new Intl.NumberFormat('en-LK', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(amount);
    };

    function initImageSlots() {
      const container = document.getElementById('pf-image-slots');
      const tpl = document.getElementById('pf-image-slot-template');
      container.innerHTML = '';
      
      for (let i = 0; i < 6; i++) {
        const node = tpl.content.cloneNode(true);
        const slot = node.querySelector('.slot');
        slot.dataset.index = i;
        const input = slot.querySelector('.slot-input');
        const previewImg = slot.querySelector('img');
        const placeholder = slot.querySelector('.slot-placeholder');
        const removeBtn = slot.querySelector('.slot-remove');

        slot.addEventListener('click', (e) => {
          if (e.target !== removeBtn) input.click();
        });

        input.addEventListener('change', () => {
          if (input.files && input.files[0]) {
            const file = input.files[0];
            const reader = new FileReader();
            reader.onload = (e) => {
              previewImg.src = e.target.result;
              previewImg.style.display = 'block';
              placeholder.style.display = 'none';
              removeBtn.style.display = 'flex';
              slot.style.borderStyle = 'solid'; // Solid border when filled
              slot.style.borderColor = '#e2e8f0';
            };
            reader.readAsDataURL(file);
            if (slot.dataset.existing) {
              window._pf_remove_filenames.push(slot.dataset.existing);
              delete slot.dataset.existing;
            }
          }
        });

        removeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (slot.dataset.existing) {
            window._pf_remove_filenames.push(slot.dataset.existing);
            delete slot.dataset.existing;
          }
          input.value = '';
          previewImg.src = '';
          previewImg.style.display = 'none';
          placeholder.style.display = 'flex';
          removeBtn.style.display = 'none';
          slot.style.borderStyle = 'dashed'; // Revert to dashed
          slot.style.borderColor = '#cbd5e1';
        });

        container.appendChild(node);
      }
    }

    function clearAllImageSlots() {
      window._pf_remove_filenames = [];
      const slots = document.querySelectorAll('#pf-image-slots .slot');
      slots.forEach(slot => {
        const input = slot.querySelector('.slot-input');
        const previewImg = slot.querySelector('img');
        const placeholder = slot.querySelector('.slot-placeholder');
        const removeBtn = slot.querySelector('.slot-remove');
        
        input.value = '';
        delete slot.dataset.existing;
        previewImg.src = '';
        previewImg.style.display = 'none';
        placeholder.style.display = 'flex';
        removeBtn.style.display = 'none';
        slot.style.borderStyle = 'dashed';
        slot.style.borderColor = '#cbd5e1';
      });
    }

    function setSlotImage(index, { url, filename }) {
      const slots = document.querySelectorAll('#pf-image-slots .slot');
      const slot = slots[index];
      if (!slot) return;
      
      const input = slot.querySelector('.slot-input');
      const previewImg = slot.querySelector('img');
      const placeholder = slot.querySelector('.slot-placeholder');
      const removeBtn = slot.querySelector('.slot-remove');
      
      previewImg.src = url;
      previewImg.style.display = 'block';
      placeholder.style.display = 'none';
      removeBtn.style.display = 'flex';
      slot.dataset.existing = filename;
      input.value = '';
      
      slot.style.borderStyle = 'solid';
      slot.style.borderColor = '#e2e8f0';
    }

    async function loadProducts() {
      try {
        const res = await fetch(`${window.API}/products.php?limit=100&sort=newest`, { credentials: 'include' });
        const data = await res.json();
        allProducts = data.products || [];
        renderProducts(allProducts);
      } catch {
        document.getElementById('products-table-body').innerHTML = `
          <tr>
            <td colspan="6">
              <div class="empty-state text-danger">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-icon text-danger"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                <p>Failed to load products. Please check your connection.</p>
              </div>
            </td>
          </tr>`;
      }
    }

    function renderProducts(products) {
      const tbody = document.getElementById('products-table-body');
      if (!products.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6">
              <div class="empty-state">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-icon"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                <strong>No products found</strong>
                <p class="text-sm">Add a product or adjust your search filters.</p>
              </div>
            </td>
          </tr>`;
        return;
      }

      tbody.innerHTML = products.map(p => {
        const thumb = p.thumbnail
          ? `<img src="${window.esc(p.thumbnail)}" alt="${window.esc(p.name)}" class="thumb shadow-sm" />`
          : '<div class="thumb thumb-empty">N/A</div>';
        const cats = (p.categories || []).map(c => `<span class="badge badge-purple">${window.esc(c.name)}</span>`).join(' ');
        
        return `<tr>
          <td>${thumb}</td>
          <td><strong class="row-title">${window.esc(p.name)}</strong></td>
          <td class="font-mono text-sm">${formatCurrency(Number(p.price))}</td>
          <td><div class="category-list flex gap-1 flex-wrap">${cats || '<span class="text-muted text-sm">--</span>'}</div></td>
          <td><span class="badge badge-blue flex items-center gap-1 w-max"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg> ${p.image_count || 0}</span></td>
          <td>
            <div class="action-group flex gap-2">
              <button class="btn btn-ghost btn-sm" onclick="editProduct(${p.id})" title="Edit">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                Edit
              </button>
              <button class="btn btn-danger btn-sm" onclick="confirmDeleteProduct(${p.id}, '${window.esc(p.name).replace(/'/g,"\\'")}')" title="Delete">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
                Delete
              </button>
            </div>
          </td>
        </tr>`;
      }).join('');
    }

    document.getElementById('product-search').addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase();
      const filtered = allProducts.filter(p =>
        (p.name || '').toLowerCase().includes(q) || (p.description || '').toLowerCase().includes(q)
      );
      renderProducts(filtered);
    });

    document.getElementById('add-product-btn').addEventListener('click', () => {
      document.getElementById('product-modal-title').textContent = 'Add Product';
      document.getElementById('product-form').reset();
      document.getElementById('pf-id').value = '';
      clearAllImageSlots();
      loadCategoryOptions();
      window.openModal('product-modal');
    });

    async function loadCategoryOptions(selectedIds = []) {
      try {
        const res = await fetch(`${window.API}/categories.php`, { credentials: 'include' });
        const data = await res.json();
        allCategories = data.categories || [];
        const sel = document.getElementById('pf-categories');
        sel.innerHTML = ['<option value="">-- Select a category --</option>']
          .concat(allCategories.map(c =>
            `<option value="${c.id}" ${selectedIds.includes(c.id) ? 'selected' : ''}>${window.esc(c.name)}</option>`
          ))
          .join('');
      } catch { /* ignore */ }
    }

    window.editProduct = async function(id) {
      const p = allProducts.find(x => x.id === id);
      if (!p) return;
      document.getElementById('product-modal-title').textContent = 'Edit Product';
      document.getElementById('pf-id').value = p.id;
      document.getElementById('pf-name').value = p.name || '';
      document.getElementById('pf-desc').value = p.description || '';
      document.getElementById('pf-price').value = p.price || 0;

      const selectedCatIds = (p.categories || []).map(c => c.id);
      await loadCategoryOptions(selectedCatIds);

      clearAllImageSlots();
      if (p.images && p.images.length) {
        for (let i = 0; i < Math.min(p.images.length, 6); i++) {
          const fullUrl = p.images[i];
          const filename = fullUrl.split('/').pop();
          setSlotImage(i, { url: fullUrl, filename });
        }
      }

      window.openModal('product-modal');
    };

    document.getElementById('product-save-btn').addEventListener('click', async () => {
      const saveBtn = document.getElementById('product-save-btn');
      const saveText = document.getElementById('product-save-text');
      const saveSpinner = document.getElementById('product-save-spinner');

      const name = document.getElementById('pf-name').value.trim();
      const price = document.getElementById('pf-price').value;
      if (!name || name.length < 2) { window.showToast('Product name is required (min 2 chars)', 'error'); return; }
      if (!price || parseFloat(price) < 0) { window.showToast('Price must be a non-negative number', 'error'); return; }

      const catSelect = document.getElementById('pf-categories');
      if (!catSelect.value) { window.showToast('Please select a category before saving', 'error'); return; }

      saveBtn.disabled = true;
      saveText.style.display = 'none';
      saveSpinner.style.display = 'inline-block';

      const formData = new FormData();
      const id = document.getElementById('pf-id').value;
      if (id) formData.append('id', id);
      formData.append('name', name);
      formData.append('description', document.getElementById('pf-desc').value);
      formData.append('price', price);
      formData.append('category_ids[]', catSelect.value);

      const removed = window._pf_remove_filenames || [];
      for (const fname of removed) {
        formData.append('remove_filenames[]', fname);
      }

      const slots = document.querySelectorAll('#pf-image-slots .slot');
      let existingCount = 0;
      let newFilesCount = 0;
      for (let i = 0; i < slots.length; i++) {
        const slot = slots[i];
        if (slot.dataset.existing) existingCount++;
        const input = slot.querySelector('.slot-input');
        if (input && input.files && input.files[0]) newFilesCount++;
      }
      
      if (existingCount + newFilesCount > 6) {
        window.showToast('You can upload up to 6 images total.', 'error');
        saveBtn.disabled = false;
        saveText.style.display = 'inline';
        saveSpinner.style.display = 'none';
        return;
      }

      for (let i = 0; i < slots.length; i++) {
        const input = slots[i].querySelector('.slot-input');
        if (input && input.files && input.files[0]) {
          formData.append('images[]', input.files[0]);
        }
      }

      try {
        const res = await fetch(`${window.API}/product_save.php`, {
          method: 'POST',
          credentials: 'include',
          body: formData
        });
        const data = await res.json();
        if (data.success) {
          window.showToast(id ? 'Product updated!' : 'Product created!');
          window.closeModal('product-modal');
          loadProducts();
        } else {
          window.showToast((data.errors || ['Save failed']).join(', '), 'error');
        }
      } catch {
        window.showToast('Network error while saving.', 'error');
      } finally {
        saveBtn.disabled = false;
        saveText.style.display = 'inline';
        saveSpinner.style.display = 'none';
      }
    });

    window.confirmDeleteProduct = function(id, name) {
      document.getElementById('delete-message').innerHTML = `Are you sure you want to delete <strong>${name}</strong>?<br>This action cannot be undone.`;
      pendingDeleteFn = async () => {
        try {
          const res = await fetch(`${window.API}/product_delete.php`, {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });
          const data = await res.json();
          if (data.success) {
            window.showToast('Product deleted successfully');
            loadProducts();
          } else {
            window.showToast(data.error || 'Delete failed', 'error');
          }
        } catch { window.showToast('Network error', 'error'); }
        window.closeModal('delete-modal');
      };
      window.openModal('delete-modal');
    };

    document.getElementById('delete-confirm-btn').addEventListener('click', () => {
      if (pendingDeleteFn) pendingDeleteFn();
    });

    initImageSlots();
    if(typeof window.setActiveNav === 'function') window.setActiveNav('products');
    loadProducts();
  </script>
</AdminLayout>