---
import '../styles/global.css';
import Navbar from '../components/navbar.astro';
import Footer from '../components/footer.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Product Details | Water Mission</title>
  <style>
    /* ── Image crossfade ── */
    #main-image {
      transition: opacity 0.22s ease;
    }
    #main-image.fading {
      opacity: 0;
    }

    /* ── Thumbnail strip ── */
    .thumb-btn {
      position: relative;
      border-radius: 12px;
      overflow: hidden;
      border: 2px solid transparent;
      cursor: pointer;
      flex-shrink: 0;
      transition: transform 0.15s ease, border-color 0.15s ease;
      background: #e8f4fd;
    }
    .thumb-btn:hover { transform: translateY(-2px); }
    .thumb-btn.active {
      border-color: #0076b6;
      box-shadow: 0 0 0 3px rgba(0,118,182,0.18);
    }
    .thumb-btn::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 3px;
      background: #0076b6;
      transform: scaleX(0);
      transition: transform 0.2s ease;
      transform-origin: center;
    }
    .thumb-btn.active::after { transform: scaleX(1); }

    /* ── CTA pulse ring ── */
    @keyframes pulseRing {
      0%   { box-shadow: 0 0 0 0 rgba(0,118,182,0.35); }
      70%  { box-shadow: 0 0 0 10px rgba(0,118,182,0); }
      100% { box-shadow: 0 0 0 0 rgba(0,118,182,0); }
    }
    .cta-btn:hover { animation: pulseRing 0.7s ease; }

    /* ── Skeleton shimmer ── */
    @keyframes shimmer {
      0%   { background-position: -600px 0; }
      100% { background-position: 600px 0; }
    }
    .skel {
      border-radius: 10px;
      background: linear-gradient(90deg, #e8f0f7 25%, #d4e6f4 50%, #e8f0f7 75%);
      background-size: 600px 100%;
      animation: shimmer 1.4s infinite linear;
    }

    /* ── Sticky panel ── */
    @media (min-width: 1024px) {
      #info-panel { position: sticky; top: 24px; align-self: flex-start; }
    }

    /* ── Fade-in for product shell ── */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    #product-shell { animation: fadeIn 0.35s ease both; }

    /* ── Image zoom on hover ── */
    #image-frame { overflow: hidden; border-radius: 20px; }
    #main-image  { transition: opacity 0.22s ease, transform 0.4s ease; }
    #image-frame:hover #main-image { transform: scale(1.03); }
  </style>
</head>
<body class="bg-[#f0f7fc] m-0 flex flex-col min-h-screen overflow-x-hidden">
  <Navbar />

  <main class="flex-grow py-10 sm:py-14 px-4 sm:px-6 md:px-10">
    <div class="max-w-6xl mx-auto">

      <!-- Breadcrumb -->
      <nav class="mb-8 flex items-center gap-2 text-sm font-medium text-slate-500">
        <a href="/products" class="hover:text-[#0076b6] transition-colors flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          All Products
        </a>
        <span class="text-slate-300">/</span>
        <span id="breadcrumb-name" class="text-slate-700 font-semibold truncate max-w-[200px] sm:max-w-xs">Product Details</span>
      </nav>

      <!-- ── Skeleton ── -->
      <section id="loading" aria-label="Loading product" class="bg-white rounded-3xl border border-[#d7ebf9] shadow-[0_14px_50px_rgba(0,86,135,0.07)] overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2">
          <!-- Image skeleton -->
          <div class="p-5 border-b lg:border-b-0 lg:border-r border-slate-100">
            <div class="skel w-full aspect-[4/3] rounded-2xl"></div>
            <div class="mt-3 flex gap-2">
              <div class="skel h-16 w-16 rounded-xl flex-shrink-0"></div>
              <div class="skel h-16 w-16 rounded-xl flex-shrink-0"></div>
              <div class="skel h-16 w-16 rounded-xl flex-shrink-0"></div>
            </div>
          </div>
          <!-- Info skeleton -->
          <div class="p-6 md:p-10 flex flex-col gap-4">
            <div class="flex gap-2">
              <div class="skel h-6 w-20 rounded-full"></div>
              <div class="skel h-6 w-24 rounded-full"></div>
            </div>
            <div class="skel h-9 w-4/5 rounded-lg"></div>
            <div class="skel h-8 w-1/3 rounded-lg"></div>
            <div class="skel h-4 w-full rounded mt-2"></div>
            <div class="skel h-4 w-5/6 rounded"></div>
            <div class="skel h-4 w-full rounded"></div>
            <div class="skel h-4 w-3/4 rounded"></div>
            <div class="mt-6 skel h-12 w-48 rounded-full"></div>
          </div>
        </div>
      </section>

      <!-- ── Not found ── -->
      <section id="not-found" class="hidden bg-white rounded-3xl border border-red-100 p-12 text-center shadow-sm">
        <div class="w-16 h-16 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h2 class="text-lg font-bold text-slate-800 mb-1">Product not found</h2>
        <p class="text-slate-500 mb-6 text-sm">This product may have been removed or the link is incorrect.</p>
        <a href="/products" class="inline-flex items-center gap-2 rounded-full bg-[#0076b6] text-white px-6 py-2.5 font-semibold text-sm hover:bg-[#005e91] transition-colors">
          ← Browse all products
        </a>
      </section>

      <!-- ── Product shell ── -->
      <section id="product-shell" class="hidden bg-white rounded-3xl border border-[#d7ebf9] shadow-[0_14px_50px_rgba(0,86,135,0.08)] overflow-hidden">
        <div class="lg:flex">

          <!-- Left: image gallery -->
          <div class="lg:w-[52%] p-5 border-b lg:border-b-0 lg:border-r border-slate-100 flex flex-col">
            <div id="image-frame" class="relative w-full bg-[#edf7ff]">
              <img
                id="main-image"
                src=""
                alt=""
                class="w-full aspect-[4/3] object-cover"
              />
              <!-- Image counter badge -->
              <div id="image-counter" class="absolute bottom-3 right-3 bg-black/40 backdrop-blur-sm text-white text-xs font-bold px-2.5 py-1 rounded-full hidden">
                1 / 1
              </div>
            </div>

            <!-- Thumbnail strip -->
            <div id="thumbs" class="mt-3 flex gap-2 overflow-x-auto pb-1 scroll-smooth" style="scrollbar-width:thin;scrollbar-color:#c8dff0 transparent;"></div>
          </div>

          <!-- Right: info panel -->
          <div id="info-panel" class="lg:w-[48%] p-6 md:p-10 flex flex-col">

            <!-- Category badges -->
            <div id="category-badges" class="flex flex-wrap gap-2 mb-5"></div>

            <!-- Name -->
            <h1 id="product-name" class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-3 leading-snug"></h1>

            <!-- Price -->
            <div class="flex items-baseline gap-3 mb-6">
              <p id="product-price" class="text-3xl font-extrabold text-[#0076b6]"></p>
              <span class="text-sm font-medium text-slate-400">Inclusive of all taxes</span>
            </div>

            <!-- Divider -->
            <div class="border-t border-slate-100 mb-6"></div>

            <!-- Description -->
            <div class="mb-2">
              <p class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-2">About this product</p>
              <p id="product-description" class="text-slate-600 leading-relaxed text-[15px]"></p>
            </div>

            <!-- Spacer pushes CTA to bottom on desktop -->
            <div class="flex-1 min-h-[24px]"></div>

            <!-- CTA block -->
            <div class="mt-8 pt-6 border-t border-slate-100">
              <p class="text-sm text-slate-500 mb-4">Interested in this product? Contact our team for pricing, availability, and delivery details.</p>
              <div class="flex flex-wrap gap-3">
                <a
                  href="/contact"
                  class="cta-btn inline-flex items-center gap-2 rounded-full bg-[#0076b6] text-white px-7 py-3.5 font-bold shadow-lg shadow-[#0076b6]/25 hover:bg-[#005e91] hover:-translate-y-0.5 transition-all duration-200"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                  Request This Product
                </a>
                <a
                  href="/products"
                  class="inline-flex items-center gap-2 rounded-full border-2 border-slate-200 text-slate-600 px-7 py-3.5 font-bold hover:border-[#0076b6] hover:text-[#0076b6] hover:-translate-y-0.5 transition-all duration-200"
                >
                  ← Back to Catalog
                </a>
              </div>
            </div>

          </div>
        </div>
      </section>

    </div>
  </main>

  <Footer />

  <script>
    function getApiBase() {
      const host = window.location.hostname;
      return (host === 'localhost' || host === '127.0.0.1')
        ? 'http://localhost:8000/public/api'
        : '/public/api';
    }

    const API_BASE   = getApiBase();
    const loadingEl  = document.getElementById('loading')       as HTMLElement;
    const notFoundEl = document.getElementById('not-found')     as HTMLElement;
    const shellEl    = document.getElementById('product-shell') as HTMLElement;

    type ProductCategory = { id?: number; name: string };
    type ProductData = {
      id: number; name: string; description?: string | null;
      price?: number | null; thumbnail?: string | null;
      images?: string[]; categories?: ProductCategory[];
    };

    function money(v: number | string | null | undefined) {
      return new Intl.NumberFormat('en-LK', { style: 'currency', currency: 'LKR' }).format(Number(v || 0));
    }
    function esc(s: string | number | null | undefined) {
      return String(s)
        .replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;')
        .replaceAll('"','&quot;').replaceAll("'",'&#39;');
    }

    /* ── Image switcher with crossfade ── */
    let currentImgIndex = 0;
    let allImages: string[] = [];

    function switchImage(src: string, idx: number, productName: string) {
      const mainImg = document.getElementById('main-image') as HTMLImageElement;
      const counter = document.getElementById('image-counter') as HTMLElement;
      if (!mainImg) return;

      mainImg.classList.add('fading');
      setTimeout(() => {
        mainImg.src = src;
        mainImg.alt = productName;
        mainImg.classList.remove('fading');
      }, 120);

      currentImgIndex = idx;
      if (counter && allImages.length > 1) {
        counter.textContent = `${idx + 1} / ${allImages.length}`;
        counter.style.display = 'block';
      }

      // Update thumb active states
      document.querySelectorAll<HTMLButtonElement>('.thumb-btn').forEach((btn, i) => {
        btn.classList.toggle('active', i === idx);
      });
    }

    async function loadProduct() {
      const productId = new URLSearchParams(location.search).get('id');
      if (!productId || !/^\d+$/.test(productId)) {
        loadingEl.style.display = 'none';
        notFoundEl.classList.remove('hidden');
        return;
      }

      try {
        const res = await fetch(`${API_BASE}/products.php?limit=1&page=1&id=${encodeURIComponent(productId)}`);
        if (!res.ok) throw new Error('bad response');

        const data: { products?: ProductData[] } = await res.json();
        const p = (data.products || []).find(item => String(item.id) === productId);
        if (!p) throw new Error('not found');

        /* ── Populate DOM ── */
        const breadcrumb = document.getElementById('breadcrumb-name') as HTMLElement;
        const nameEl     = document.getElementById('product-name')    as HTMLElement;
        const priceEl    = document.getElementById('product-price')   as HTMLElement;
        const descEl     = document.getElementById('product-description') as HTMLElement;
        const badgesEl   = document.getElementById('category-badges') as HTMLElement;
        const thumbsEl   = document.getElementById('thumbs')          as HTMLDivElement;

        const displayName = p.name || 'Unnamed Product';
        document.title    = `${displayName} | Water Mission`;
        if (breadcrumb) breadcrumb.textContent = displayName;
        nameEl.textContent  = displayName;
        priceEl.textContent = money(p.price);
        descEl.textContent  = p.description || 'No product description available.';

        badgesEl.innerHTML = (p.categories || []).map(c =>
          `<span class="inline-flex items-center text-xs font-bold px-3 py-1.5 rounded-full bg-[#e8f4fd] text-[#005f92] border border-[#c6e2f5]">${esc(c.name)}</span>`
        ).join('');

        /* ── Images ── */
        allImages = (p.images?.length ? p.images : [p.thumbnail]).filter((s): s is string => Boolean(s));
        if (!allImages.length) allImages = ['/placeholder.png'];

        // Set initial main image
        const mainImg = document.getElementById('main-image') as HTMLImageElement;
        mainImg.src = allImages[0];
        mainImg.alt = displayName;

        const counter = document.getElementById('image-counter') as HTMLElement;
        if (allImages.length > 1 && counter) {
          counter.textContent  = `1 / ${allImages.length}`;
          counter.style.display = 'block';
        }

        // Build thumbnails
        thumbsEl.innerHTML = allImages.map((src, idx) => `
          <button type="button" class="thumb-btn ${idx === 0 ? 'active' : ''}" data-idx="${idx}" data-src="${esc(src)}" title="View image ${idx + 1}">
            <img src="${esc(src)}" alt="${esc(displayName)} — image ${idx + 1}" class="h-[72px] w-[72px] sm:w-[88px] object-cover" loading="lazy" />
          </button>
        `).join('');

        thumbsEl.querySelectorAll<HTMLButtonElement>('.thumb-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const idx = Number(btn.dataset.idx);
            switchImage(btn.dataset.src || '', idx, displayName);
          });
        });

        // Keyboard arrow navigation
        document.addEventListener('keydown', (e) => {
          if (allImages.length <= 1) return;
          if (e.key === 'ArrowRight') switchImage(allImages[(currentImgIndex + 1) % allImages.length], (currentImgIndex + 1) % allImages.length, displayName);
          if (e.key === 'ArrowLeft')  switchImage(allImages[(currentImgIndex - 1 + allImages.length) % allImages.length], (currentImgIndex - 1 + allImages.length) % allImages.length, displayName);
        });

        /* ── Show shell ── */
        loadingEl.style.display = 'none';
        shellEl.classList.remove('hidden');

      } catch {
        loadingEl.style.display = 'none';
        notFoundEl.classList.remove('hidden');
      }
    }

    loadProduct();
  </script>
</body>
</html>